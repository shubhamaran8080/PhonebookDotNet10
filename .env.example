# Database credentials (the container database is created on first start)
POSTGRES_USER=phonebook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phonebook_dotnet10

# JWT signing key (generate with: openssl rand -base64 32)
# When empty, the backend generates an ephemeral key on every start and
# all tokens become invalid after a restart.
JWT_SECRET_KEY=

# Host ports. The Java Phonebook app already uses 8000/8080, so this
# project publishes 8001/8081 by default.
BACKEND_PORT=8001
FRONTEND_PORT=8081

# Seeding (disabled by default, always manual)
# The seed utility never resets or removes existing data.
SEED_CREATE_USER=false
SEED_USERNAME=
SEED_PASSWORD=
SEED_EMAIL=
SEED_COUNT=0
